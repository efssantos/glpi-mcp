GLPI_URL=https://glpi.example.com
GLPI_API_PATH=/apirest.php
GLPI_APP_TOKEN=your-app-token
# Provide either GLPI_USER_TOKEN, or both username and password.
GLPI_USER_TOKEN=your-user-token
# GLPI_USERNAME=integration-user
# GLPI_PASSWORD=your-password
GLPI_TIMEOUT=30
GLPI_VERIFY_TLS=true

# Remote deployment via Docker Compose
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PROXY_MODE=true
MCP_PORT=8000
MCP_AUTH_ENABLED=true

MCP_DOMAIN=mcp.example.com
KC_DOMAIN=auth.example.com
MCP_PUBLIC_URL=https://mcp.example.com/mcp
OIDC_ISSUER_URL=https://auth.example.com/realms/glpi-mcp
OIDC_JWKS_URL=https://auth.example.com/realms/glpi-mcp/protocol/openid-connect/certs
OIDC_AUDIENCE=glpi-mcp
MCP_READ_SCOPE=glpi:read
MCP_WRITE_SCOPE=glpi:write

# Keycloak and PostgreSQL bootstrap secrets. Replace with strong unique values.
KC_DB_PASSWORD=replace-with-strong-db-password
KC_ADMIN_USERNAME=replace-with-admin-username
KC_ADMIN_PASSWORD=replace-with-strong-admin-password

LOG_LEVEL=INFO
